[Unit]
Description=Ekko Studio for TOS
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=/usr/local/@APP_ID@/data
ExecStart=/usr/local/@APP_ID@/bin/ekko-studio
Environment=NODE_ENV=production
Environment=BIND_HOST=0.0.0.0
Environment=PORT=@PORT@
Environment=HOME=/usr/local/@APP_ID@/data/home
Environment=HERMES_HOME=/usr/local/@APP_ID@/data/home/.hermes
Environment=HERMES_WEB_UI_HOME=/usr/local/@APP_ID@/data/studio
Environment=HERMES_WEBUI_STATE_DIR=/usr/local/@APP_ID@/data/studio
Environment=WORKSPACE_BASE=/usr/local/@APP_ID@/data/workspaces
Environment=TMPDIR=/usr/local/@APP_ID@/data/tmp
Environment=XDG_CACHE_HOME=/usr/local/@APP_ID@/data/cache
Environment=NPM_CONFIG_PREFIX=/usr/local/@APP_ID@/data/npm
Environment=HERMES_WEB_UI_MCP_BIN=/usr/local/@APP_ID@/depends/webui/bin/ekko-studio-mcp.mjs
Environment=HERMES_AGENT_NODE=/usr/local/@APP_ID@/depends/bin/node
Environment=HERMES_WEB_UI_DISABLE_UPDATE_CHECK=1
Environment=PATH=/usr/local/@APP_ID@/data/npm/bin:/usr/local/@APP_ID@/depends/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=30
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/usr/local/@APP_ID@/data /usr/local/@APP_ID@/logs
UMask=0077
LimitNOFILE=65536
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
