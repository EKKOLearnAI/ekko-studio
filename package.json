    "eventsource": "^4.1.0",
    "js-tiktoken": "^1.0.21",
    "katex": "^0.17.0",
    "node-edge-tts": "^1.2.12",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.3",
    "sherpa-onnx-node": "1.13.3",
    "smol-toml": "^1.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "werift": "0.24.4",
    "yaml": "^2.9.0",
    "@huggingface/transformers": "^3.8.1",
    "chokidar": "^4.0.3",
    "docx": "^9.7.1",
    "konva": "^10.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "roughjs": "^4.6.6"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "1.13.3",
    "sherpa-onnx-darwin-x64": "1.13.3",
    "sherpa-onnx-linux-arm64": "1.13.3",
