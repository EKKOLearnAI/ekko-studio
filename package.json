{
  "name": "@quanthermes/hermes-web-ui",
  "version": "0.8.21",
  "description": "Ekko Studio is a local-first AI workspace for multi-agent chat, coding, and visual workflows, available on desktop and the web.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangledup-ai/hermes-web-ui.git"
  },
  "homepage": "https://github.com/tangledup-ai/hermes-web-ui",
  "license": "BSL-1.1",
  "engines": {
    "node": ">=23.0.0"
  },
  "keywords": [
    "ekko-studio",
    "ekko-agent",
    "multi-agent",
    "coding-agents",
    "workflow-automation",
    "hermes",
    "hermes-agent",
    "hermes-web",
    "agent",
    "ai",
    "ai-agent",
    "ai-chat",
    "ai-dashboard",
    "llm",
    "multi-model",
    "chat-ui",
    "dashboard",
    "self-hosted",
    "multi-platform",
    "vue3",
    "typescript"
  ],
  "bin": {
    "hermes-web-ui": "./bin/hermes-web-ui.mjs",
    "hermes-web-ui-mcp": "./bin/hermes-web-ui-mcp.mjs",
    "hermes-studio-mcp": "./bin/hermes-studio-mcp.mjs",
    "ekko-studio-mcp": "./bin/ekko-studio-mcp.mjs",
    "ekko-studio-web": "./bin/hermes-web-ui.mjs",
    "ekko-studio": "./bin/hermes-web-ui.mjs"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 6060",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cross-env HERMES_WEB_UI_BACKEND_PORT=8647 vite --host 0.0.0.0 --port 6060 --strictPort",
    "dev:server": "nodemon",
    "build": "node scripts/plugin-docs-harness.mjs && npm run openapi:generate && vue-tsc -b && vite build && tsc --noEmit -p packages/server/tsconfig.json && node scripts/build-server.mjs",
    "harness:check": "node scripts/harness-check.mjs && npm --prefix packages/ekko-agent run api:docs:check",
    "artifacts:check": "node scripts/task-artifacts-cli.mjs check",
    "artifacts:dir": "node scripts/task-artifacts-cli.mjs dir",
    "artifacts:new": "node scripts/task-artifacts-cli.mjs new",
    "test:ekko-agent": "vitest run tests/ekko-agent",
    "build:ekko-agent": "npm --prefix packages/ekko-agent run build",
    "verify:sharp-runtime": "node scripts/verify-sharp-runtime.mjs",
    "prepare": "[ -d dist ] || npm run build",
    "preview": "NODE_ENV=production vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui --pass-with-no-tests",
    "mcu:v1:flash:clean": "pio run -d packages/mcu/esp32-c3/v1 && pio run -d packages/mcu/esp32-c3/v1 -t erase && pio run -d packages/mcu/esp32-c3/v1 -t upload",
    "mcu:v2:flash:clean": "pio run -d packages/mcu/esp32-c3/v2 && pio run -d packages/mcu/esp32-c3/v2 -t erase && pio run -d packages/mcu/esp32-c3/v2 -t upload",
    "mcu:flash:clean": "npm run mcu:v1:flash:clean",
    "desktop:install": "npm ci --prefix packages/desktop --no-audit --no-fund",
    "desktop:prepare-runtime": "npm --prefix packages/desktop run prepare:runtime",
    "desktop:prepare-python": "npm --prefix packages/desktop run prepare:python",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "build:desktop": "npm run build && npm run desktop:install && npm --prefix packages/desktop run dist -- --publish never",
    "build:desktop:mac": "npm run build && npm run desktop:install && npm --prefix packages/desktop run dist -- --mac --publish never",
    "build:desktop:win": "npm run build && npm run desktop:install && npm --prefix packages/desktop run dist -- --win --publish never",
    "build:desktop:linux": "npm run build && npm run desktop:install && npm --prefix packages/desktop run dist -- --linux --publish never",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "claude": "claude --dangerously-skip-permissions",
    "pack:npm": "node scripts/pack-npm-releases.mjs",
    "publish:npm": "node scripts/publish-npm-releases.mjs",
    "check:release-consistency": "node scripts/check-release-consistency.mjs",
    "test:device-package-release": "vitest run tests/server/build-device-package-script.test.ts tests/server/device-package-contract.test.ts tests/server/device-package-strategy.test.ts tests/server/update-manifest-client.test.ts tests/server/verify-terminal-runtime.test.ts tests/release/device-package-manifest.test.ts",
    "build:device-package": "node scripts/build-device-package.mjs",
    "build:verify": "node scripts/guard-no-inline-data-urls.mjs",
    "prepublishOnly": "npm run build",
    "release:npm": "npm publish --access public",
    "desktop:install:webui": "npm ci --ignore-scripts && npm rebuild node-pty",
    "desktop:restore-deps": "npm ci --no-audit --no-fund",
    "desktop:prune": "npm prune --omit=dev --no-audit --no-fund",
    "build:desktop:release": "npm run check:release-consistency && npm run build && npm run desktop:prune && npm run verify:sharp-runtime && npm run desktop:install && npm --prefix packages/desktop run dist -- --publish never",
    "build:desktop:release:mac": "npm run check:release-consistency && npm run build && npm run desktop:prune && npm run verify:sharp-runtime && npm run desktop:install && npm --prefix packages/desktop run dist -- --mac --publish never",
    "build:desktop:release:win": "npm run check:release-consistency && npm run build && npm run desktop:prune && npm run verify:sharp-runtime && npm run desktop:install && npm --prefix packages/desktop run dist -- --win --publish never",
    "build:desktop:release:linux": "npm run check:release-consistency && npm run build && npm run desktop:prune && npm run verify:sharp-runtime && npm run desktop:install && npm --prefix packages/desktop run dist -- --linux --publish never"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "dependencies": {
    "@audio/decode-mp3": "^1.1.0",
    "@audio/decode-wav": "^1.2.0",
