{
  "schemaVersion": 1,
  "id": "example.echo",
  "version": "1.0.0",
  "engines": {
    "studioSdk": "^0.1.0",
    "rpc": 1
  },
  "backend": "index.cjs",
  "activation": "global",
  "contributes": {
    "agents": [
      "example.echo/assistant"
    ],
    "commands": [
      "example.echo/echo"
    ]
  },
  "requires": {
    "capabilities": [
      "agents.register",
      "events.subscribe:run.completed",
      "commands.register"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "prefix": {
        "type": "string",
        "maxLength": 100
      }
    },
    "additionalProperties": false
  }
}
