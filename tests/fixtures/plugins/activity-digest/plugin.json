{
  "id": "activity-digest",
  "name": "Activity digest",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Observe Studio business events and produce a recurring or workflow-triggered digest.",
  "server": "server.mjs",
  "permissions": [
    "events",
    "automation",
    "commands"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "intervalMs": {
        "type": "integer",
        "minimum": 10000,
        "default": 60000
      }
    },
    "additionalProperties": false
  },
  "author": {
    "name": "Ekko Studio",
    "url": "https://github.com/EKKOLearnAI"
  },
  "repository": "https://github.com/EKKOLearnAI/ekko-studio",
  "documentation": "https://github.com/EKKOLearnAI/ekko-studio/blob/main/docs/plugins.md"
}
